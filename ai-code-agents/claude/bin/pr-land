#!/usr/bin/env bash
# pr-land: NOTIFY-ONLY watch on one pull request at one pinned commit. It never merges.
# The owner arms a watch; a periodic sweep later writes a notice ("ready" with the exact
# merge command as text, or why not). The owner's paste of that text is the authorization.
# Its only gh subcommand is `pr view`; it runs no git command and no other write.
#
# Usage:
#   pr-land arm <owner/repo> <pr> --sha <head> [--rearm]
#   pr-land sweep
#   pr-land list
#   pr-land cancel <owner/repo> <pr>
# State:  ${XDG_STATE_HOME:-$HOME/.local/state}/pr-land/<owner>__<repo>__<pr>.json
#         notices.log in the same directory (every notice, UTC timestamp, always)
# Config: ${XDG_CONFIG_HOME:-$HOME/.config}/pr-land/notify.conf with a line
#         NOTIFY_CMD=<absolute path to an executable>; called with the notice as its only argument.
# Env:    PR_LAND_NOW  ISO timestamp used as "now". A TEST SEAM; invalid value exits 10.
#         PR_LAND_LOCK_WAIT  seconds arm and cancel wait for the shared lock (default 30; test seam).
# exit:   0 ok, 1 refused or unknown target, 10 usage error or missing gh, jq, flock or timeout (all four are required).
set -uo pipefail

usage() {
  cat >&2 <<'U'
usage: pr-land arm <owner/repo> <pr> --sha <head> [--rearm]
       pr-land sweep
       pr-land list
       pr-land cancel <owner/repo> <pr>
U
  exit 10
}

for tool in gh jq flock timeout; do
  command -v "$tool" >/dev/null 2>&1 || { echo "pr-land: $tool not found" >&2; exit 10; }
done

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/pr-land"
conf="${XDG_CONFIG_HOME:-$HOME/.config}/pr-land/notify.conf"
REPO_RE='^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$'
SHA_RE='^[0-9a-fA-F]{7,40}$'
BASE_RE='^[A-Za-z0-9 ._:/()@+-]*$'   # the alphabet jq reduces free text to
ISO_RE='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
EXPIRE_SECS=$((72 * 3600)); NOCHECK_SECS=$((15 * 60)); KEEP_SECS=$((14 * 86400))

iso() { date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ; }
epoch_of() { date -u -d "$1" +%s 2>/dev/null; }
if [ -n "${PR_LAND_NOW:-}" ]; then
  [[ "$PR_LAND_NOW" =~ $ISO_RE ]] && NOW="$(date -u -d "$PR_LAND_NOW" +%s 2>/dev/null)" \
    || { echo "pr-land: PR_LAND_NOW must be an ISO UTC timestamp like 2026-01-02T03:04:05Z" >&2; exit 10; }
else NOW="$(date -u +%s)"; fi

state_file() { echo "$state_dir/${1%%/*}__${1##*/}__$2.json"; }
jget() { jq -r --arg k "$2" '.[$k] // empty | tostring' "$1" 2>/dev/null; }

# write_json FILE JQ_FILTER [jq args...]: filter applied to the existing file (or null), atomic.
write_json() {
  local file="$1" filter="$2"; shift 2
  local tmpf; mkdir -p "$state_dir"
  tmpf="$(mktemp "$state_dir/.tmp.XXXXXX")" || return 1
  if [ -e "$file" ]; then jq "$@" "$filter" "$file" >"$tmpf"; else jq -n "$@" "$filter" >"$tmpf"; fi \
    && mv -f "$tmpf" "$file" || { rm -f "$tmpf"; return 1; }
}

# ---- notices ----
# notifier: prints the configured executable. Returns 2 when none is configured (the log
# line is then the whole notice), 1 when the configured path is unusable.
notifier() {
  local line cmd
  [ -r "$conf" ] || return 2
  line="$(grep -E '^NOTIFY_CMD=' "$conf" | tail -n1)"; [ -n "$line" ] || return 2
  cmd="${line#NOTIFY_CMD=}"
  case "$cmd" in /*) ;; *) return 1 ;; esac
  [ -f "$cmd" ] && [ -x "$cmd" ] || return 1
  printf '%s' "$cmd"
}
deliver() {  # MSG; 0 when delivered
  local cmd rc; cmd="$(notifier)"; rc=$?
  [ $rc -eq 2 ] && return 0
  [ $rc -eq 0 ] || return 1
  timeout -k 5 20 "$cmd" "$1" >/dev/null 2>&1 9>&-
}
log_notice() { mkdir -p "$state_dir"; printf '%s %s\n' "$(iso "$NOW")" "$1" >>"$state_dir/notices.log"; }
notified=" "
# notice FILE MSG: log always, try the notifier, keep the text pending when it fails
notice() {
  log_notice "$2"
  notified="$notified$1 "
  if ! deliver "$2"; then write_json "$1" '.pending_msg=$m' --arg m "$2"; fi
}
# finish FILE STATUS MSG: terminal state first (at most one notice), then the notice
finish() {
  write_json "$1" '.status=$s | .closed_at=$t' --arg s "$2" --arg t "$(iso "$NOW")" || return 1
  notice "$1" "$3"
}

# ---- validation of a state file; sets repo pr sha base armed status ----
load_state() {
  local f="$1"
  jq -e 'type=="object" and (.repo|type=="string") and (.sha|type=="string") and ((.pr|type=="number") or (.pr|type=="string"))' "$f" >/dev/null 2>&1 || return 1
  repo="$(jget "$f" repo)"; pr="$(jget "$f" pr)"; sha="$(jget "$f" sha)"
  base="$(jget "$f" base)"; armed="$(jget "$f" armed_at)"; status="$(jget "$f" status)"
  [[ "$repo" =~ $REPO_RE ]] && [[ "$pr" =~ ^[1-9][0-9]*$ ]] && [[ "$sha" =~ $SHA_RE ]] \
    && [[ "$base" =~ $BASE_RE ]] && [[ "$armed" =~ $ISO_RE ]] && epoch_of "$armed" >/dev/null
}
# stale FILE: 0 when a terminal file is older than 14 days
stale() {
  local f="$1" at e
  [ "$status" = armed ] && return 1
  at="$(jget "$f" closed_at)"; [ -n "$at" ] || at="$armed"
  e="$(epoch_of "$at")" || return 1
  [ $((NOW - e)) -gt "$KEEP_SECS" ]
}
each_state() {  # calls "$1" FILE for every valid, fresh state file; skips the others
  local f name
  for f in "$state_dir"/*.json; do
    [ -e "$f" ] || continue
    name="${f##*/}"
    if ! load_state "$f"; then echo "pr-land: skipping invalid state file $name" >&2; continue; fi
    stale "$f" && continue
    "$1" "$f"
  done
}

classify_gh_error() {  # only specific gh phrases; anything else is plain "gh"
  local t; t="$(tr '[:upper:]' '[:lower:]' <<<"$1")"
  case "$t" in
    *"http 401"*|*"bad credentials"*|*"gh auth login"*|*"not logged in"*|*"authentication required"*) echo auth ;;
    *"http 404"*|*"could not resolve to a"*|*"not found"*) echo notfound ;;
    *) echo gh ;;
  esac
}
clean_name() { printf '%.80s' "$(printf '%s' "$1" | tr -c 'A-Za-z0-9 ._/:()-' '_')"; }

# gh_fail FILE CLASS: count one failed look at the PR; the third in a row sends one notice
gh_fail() {
  local f="$1" failures
  failures=$(( $(jget "$f" gh_failures | grep -E '^[0-9]+$' || echo 0) + 1 ))
  write_json "$f" '.gh_failures=$n' --argjson n "$failures"
  if [ "$failures" -eq 3 ] && [ "$(jget "$f" gh_alerted)" != true ]; then
    write_json "$f" '.gh_alerted=true'
    notice "$f" "PR-LAND $repo#$pr gh-error:$2"
  fi
}
jv() { jq -r ".$1" <<<"$v" | head -n 1; }  # one scalar, first line only

# ---- verdict for one armed state file ----
check_one() {
  local f="$1" out rc cls v s d h b m rv n nfail npend fname
  if [ $((NOW - $(epoch_of "$armed"))) -gt "$EXPIRE_SECS" ]; then
    finish "$f" expired "PR-LAND $repo#$pr expired sha=$sha : armed more than 72 hours ago"; return
  fi
  out="$(timeout -k 5 60 gh pr view "$pr" -R "$repo" --json state,isDraft,headRefOid,baseRefName,mergeable,reviewDecision,statusCheckRollup 2>"$state_dir/.gh-err.$$" 9>&-)"; rc=$?
  v=""
  if [ $rc -eq 0 ]; then
    # The whole verdict is computed in jq. Free text from gh is reduced to a safe alphabet
    # and capped there; each scalar is then read on its own, so no name can share a record
    # with a flag.
    v="$(jq -c '
      def clean($n): (. // "" | tostring | gsub("[^A-Za-z0-9 ._:/()@+-]"; "_") | .[0:$n]);
      def items: (.statusCheckRollup // []);
      def failing: ((.conclusion // "") | IN("FAILURE","CANCELLED","TIMED_OUT","ACTION_REQUIRED","STARTUP_FAILURE"))
                   or ((.state // "") | IN("FAILURE","ERROR"));
      def good: ((.conclusion // "") | IN("SUCCESS","NEUTRAL","SKIPPED")) or (((.__typename // "") == "StatusContext") and ((.state // "") == "SUCCESS"));
      def head40: (.headRefOid // "" | if type == "string" and test("^[0-9a-fA-F]{40}$") then ascii_downcase else "" end);
      if (type == "object") and (.state | type == "string") and (.isDraft | type == "boolean")
         and ((.statusCheckRollup | type) | IN("array", "null")) then
      { state: (.state | clean(20)), draft: ((.isDraft // false) == true), head: head40,
        base: (.baseRefName | clean(100)), mergeable: (.mergeable | clean(20)), review: (.reviewDecision | clean(30)),
        total: (items | length), failed: (items | map(select(failing)) | length),
        pending: (items | map(select((failing | not) and (good | not))) | length),
        fname: ((items | map(select(failing)) | first // {}) | (.name // .context // "check") | clean(80)) } end' <<<"$out" 2>/dev/null)" || v=""
    if [ -z "$v" ]; then rc=1; echo "unusable output" >"$state_dir/.gh-err.$$"; fi
  fi
  if [ $rc -eq 0 ]; then
    s="$(jv state)"; d="$(jv draft)"; h="$(jv head)"; b="$(jv base)"; m="$(jv mergeable)"; rv="$(jv review)"
    n="$(jv total)"; nfail="$(jv failed)"; npend="$(jv pending)"; fname="$(jv fname)"
    # a reply that is not well formed is a failed look, never a verdict
    if ! [[ "$n" =~ ^[0-9]+$ && "$nfail" =~ ^[0-9]+$ && "$npend" =~ ^[0-9]+$ && "$h" =~ ^[0-9a-f]{40}$ ]] \
       || { [ "$s" != OPEN ] && [ "$s" != MERGED ] && [ "$s" != CLOSED ]; } \
       || { [ "$d" != true ] && [ "$d" != false ]; }; then
      rc=1; echo "unusable output" >"$state_dir/.gh-err.$$"
    fi
  fi
  if [ $rc -ne 0 ]; then
    cls="$(classify_gh_error "$(cat "$state_dir/.gh-err.$$" 2>/dev/null)")"; rm -f "$state_dir/.gh-err.$$"
    gh_fail "$f" "$cls"
    return
  fi
  rm -f "$state_dir/.gh-err.$$"
  if [ "$(jget "$f" gh_failures)" != 0 ] || [ "$(jget "$f" gh_alerted)" = true ]; then
    write_json "$f" '.gh_failures=0 | .gh_alerted=false'
  fi
  rv="$(printf '%s' "$rv" | tr -dc 'A-Z_')"; [ -n "$rv" ] || rv=none
  if [ "$s" = MERGED ] || [ "$s" = CLOSED ]; then
    finish "$f" closed "PR-LAND ${repo}#${pr} closed sha=$sha : pull request is $s"; return; fi
  if [ "$h" != "$sha" ]; then
    finish "$f" head-changed "PR-LAND $repo#$pr head-changed sha=$sha new=$h : pr-land arm $repo $pr --sha $h"; return; fi
  if [ "$b" != "$base" ]; then
    finish "$f" base-changed "PR-LAND $repo#$pr base-changed sha=$sha : base is now $b, was $base"; return; fi
  if [ "$d" = true ]; then
    finish "$f" draft "PR-LAND $repo#$pr draft sha=$sha : pull request is a draft"; return; fi
  if [ "$nfail" -gt 0 ]; then
    finish "$f" "failed:$fname" "PR-LAND $repo#$pr failed:$fname sha=$sha"; return; fi
  [ "$npend" -gt 0 ] && return
  if [ "$n" -eq 0 ]; then
    [ $((NOW - $(epoch_of "$armed"))) -gt "$NOCHECK_SECS" ] \
      && finish "$f" no-checks "PR-LAND $repo#$pr no-checks sha=$sha : no checks reported 15 minutes after arming"
    return
  fi
  if [ "$m" = CONFLICTING ]; then
    finish "$f" not-mergeable "PR-LAND $repo#$pr not-mergeable sha=$sha : merge conflicts"; return; fi
  [ "$m" = MERGEABLE ] || return
  # ready only by positive proof of every condition, together; otherwise a failed look
  if [ "$s" = OPEN ] && [ "$d" = false ] && [ "$n" -gt 0 ] && [ "$nfail" -eq 0 ] && [ "$npend" -eq 0 ] \
     && [ "$m" = MERGEABLE ] && [ "$h" = "$sha" ] && [ "$b" = "$base" ]; then
    finish "$f" ready "PR-LAND $repo#$pr ready sha=$sha review=$rv : gh pr merge $pr -R $repo --squash --match-head-commit $sha"
  else
    gh_fail "$f" gh
  fi
}

sweep_one() { [ "$status" = armed ] && check_one "$1"; }
retry_one() {
  local f="$1" msg
  case "$notified" in *" $f "*) return ;; esac
  msg="$(jget "$f" pending_msg)"; [ -n "$msg" ] || return
  # a stored notice is untrusted: strip control characters, cap it, require our own prefix
  msg="$(printf '%s' "$msg" | tr -d '[:cntrl:]' | cut -c1-500)"
  case "$msg" in
    "PR-LAND "*) ;;
    *) echo "pr-land: dropped an unusable pending notice in ${f##*/}" >&2; write_json "$f" '.pending_msg=""'; return ;;
  esac
  deliver "$msg" && write_json "$f" '.pending_msg=""'
}

lock_wait() {  # arm and cancel: wait (bounded) for the lock the sweep holds
  local w="${PR_LAND_LOCK_WAIT:-30}"
  [[ "$w" =~ ^[0-9]+$ ]] || w=30
  mkdir -p "$state_dir"
  exec 9>"$state_dir/.lock"
  flock -w "$w" 9 || { echo "pr-land: could not get the lock within ${w}s (a sweep is running?)" >&2; exit 1; }
}

cmd_sweep() {
  mkdir -p "$state_dir"
  exec 9>"$state_dir/.lock"
  flock -n 9 || { echo "PR-LAND sweep skipped: another sweep is running"; exit 0; }
  each_state sweep_one
  each_state retry_one
  exit 0
}

cmd_arm() {
  [ $# -ge 2 ] || usage
  local r="$1" p="$2" want="" rearm=false; shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --sha) [ $# -ge 2 ] || usage; want="$2"; shift 2 ;;
      --rearm) rearm=true; shift ;;
      *) usage ;;
    esac
  done
  [[ "$r" =~ $REPO_RE ]] || { echo "pr-land: bad repo: $r" >&2; usage; }
  [[ "$p" =~ ^[1-9][0-9]*$ ]] || { echo "pr-land: bad PR number: $p" >&2; usage; }
  [[ "$want" =~ $SHA_RE ]] || { echo "pr-land: --sha must be 7 to 40 hex characters" >&2; usage; }
  want="${want,,}"
  local out head base st dr
  out="$(timeout -k 5 60 gh pr view "$p" -R "$r" --json state,isDraft,headRefOid,baseRefName 2>/dev/null)" \
    && jq -e 'type=="object"' >/dev/null 2>&1 <<<"$out" || { echo "pr-land: cannot read $r#$p with gh" >&2; exit 1; }
  st="$(jq -r '.state // ""' <<<"$out")"; dr="$(jq -r '.isDraft // false' <<<"$out")"
  head="$(jq -r '.headRefOid // ""' <<<"$out" | tr 'A-F' 'a-f')"; base="$(jq -r '.baseRefName // "" | tostring | gsub("[^A-Za-z0-9 ._:/()@+-]"; "_") | .[0:100]' <<<"$out" | head -n 1)"
  [ "$st" = OPEN ] || { echo "pr-land: $r#$p is not open ($st)" >&2; exit 1; }
  [ "$dr" != true ] || { echo "pr-land: $r#$p is a draft" >&2; exit 1; }
  [[ "$head" =~ ^[0-9a-f]{40}$ ]] && [[ "$head" == "$want"* ]] || { echo "pr-land: head of $r#$p does not start with $want" >&2; exit 1; }
  [ -n "$base" ] || { echo "pr-land: no base branch name" >&2; exit 1; }
  lock_wait
  local f; f="$(state_file "$r" "$p")"
  if [ -e "$f" ]; then
    load_state "$f" || { echo "pr-land: $f is not a valid state file; not touching it" >&2; exit 1; }
  fi
  if [ -e "$f" ] && [ "$status" = armed ]; then
    if [ "$sha" = "$head" ]; then echo "PR-LAND $r#$p armed sha=$head"; exit 0; fi
    $rearm || { echo "pr-land: $r#$p is already armed at $sha; use --rearm" >&2; exit 1; }
  fi
  write_json "$f" '{repo:$repo,pr:($pr|tonumber),sha:$sha,base:$base,armed_at:$at,status:"armed",gh_failures:0,gh_alerted:false,pending_msg:""}' \
    --arg repo "$r" --arg pr "$p" --arg sha "$head" --arg base "$base" --arg at "$(iso "$NOW")" || exit 1
  echo "PR-LAND $r#$p armed sha=$head"
}

list_one() { echo "$repo $pr ${sha:0:7} $status $armed"; }
cmd_list() { each_state list_one; }

cmd_cancel() {
  [ $# -eq 2 ] || usage
  [[ "$1" =~ $REPO_RE ]] && [[ "$2" =~ ^[1-9][0-9]*$ ]] || usage
  lock_wait
  local f; f="$(state_file "$1" "$2")"
  [ -e "$f" ] || { echo "pr-land: nothing armed for $1#$2" >&2; exit 1; }
  write_json "$f" '.status="cancelled" | .closed_at=$t' --arg t "$(iso "$NOW")" || exit 1
  echo "PR-LAND $1#$2 cancelled"
}

[ $# -ge 1 ] || usage
cmd="$1"; shift
case "$cmd" in
  arm) cmd_arm "$@" ;;
  sweep) [ $# -eq 0 ] || usage; cmd_sweep ;;
  list) [ $# -eq 0 ] || usage; cmd_list ;;
  cancel) cmd_cancel "$@" ;;
  *) usage ;;
esac
