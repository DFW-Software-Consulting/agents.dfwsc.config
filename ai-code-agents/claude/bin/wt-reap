#!/usr/bin/env bash
# wt-reap: report which git worktrees of one repository are safe to remove; optionally remove them.
# Usage:  wt-reap [--repo <path>] [--apply] [--include-ignored] [--json]
#   --repo             the repository to inspect (default: the repository containing the current directory)
#   --apply            remove the worktrees reported REMOVABLE, one at a time, after re-checking each
#   --include-ignored  accept ignored files that are not on the safe list (they are deleted with the worktree)
#   --json             print one JSON array instead of text lines
# Report mode (the default) changes nothing. For each linked worktree it prints one line:
#   REMOVABLE <path> <branch> pr=<n> [upstream=gone] [ignored=<k>]    or    KEEP <path> <branch> <reason>
# then, for each removable one, the command --apply would run, then a summary line.
# A worktree is REMOVABLE only if every condition holds; the first one that fails is the KEEP reason:
#   1 not the main working tree, path does not end in -main   2 not the current directory or a parent
#   3 a branch is checked out and it is not the default branch   4 clean tree (submodules included; a lone
#   untracked .worktree-meta is ignored; untracked files count as dirty). Ignored files: `git worktree remove`
#   deletes them with the worktree, so an ignored entry must be regenerable (built-in list such as node_modules,
#   __pycache__, dist, *.pyc, or a glob in ${XDG_CONFIG_HOME:-$HOME/.config}/wt-reap/ignorable, read as data, one
#   per line, # comments) unless --include-ignored is given; an ignored directory holding a nested repository is
#   always KEEP   5 the branch has an upstream and the local tip equals it; if the upstream was configured but its
#   remote-tracking ref is gone (deleted after a merge) only condition 6 stands in for it   6 a MERGED pull
#   request has that branch as head and its head commit equals the branch tip (one `gh pr list` call per branch)
#   7 no stash entry names the branch, not locked, no rebase/merge/cherry-pick/revert/bisect in progress
# --apply re-checks all of this just before acting, then runs `git worktree remove` and, only if that worked,
# `git branch -d`; neither is ever forced and no worktree file is deleted any other way (the tool's own temporary
# directory is the only other thing it removes). With the upstream gone, git usually refuses `branch -d`; the
# branch is then left in place and said so, and that is success. A failed removal is printed, left as it is, and the
# next worktree is tried. If gh or `git worktree list` fails during a re-check, that worktree and all later ones are
# SKIPPED, the results so far are printed, and the exit code is 10.
# Env:    WT_REAP_GH_PATH  a PATH used to resolve gh; honoured ONLY when WT_REAP_TEST=1 (otherwise ignored).
# gh runs under `env -i` with a fixed PATH and a short pass-list of variables, under a timeout.
# exit:   0 report produced / apply finished without a failed removal, 1 a removal failed in --apply,
#         2 usage error or not a repository, 10 gh unavailable (message `wt-reap: gh unavailable`; nothing is
#         removed when it happens while judging).
set -uo pipefail
LC_ALL=C; export LC_ALL
for _v in GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_NAMESPACE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES; do unset "$_v"; done
unset _v
export GIT_OPTIONAL_LOCKS=0   # a report must not even refresh an index

USAGE="usage: wt-reap [--repo <path>] [--apply] [--include-ignored] [--json]"
usage() { echo "$USAGE" >&2; exit 2; }

REPO=""; APPLY=0; JSON=0; INCL=0
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) [ $# -ge 2 ] || usage; REPO="$2"; shift 2 ;;
    --repo=*) REPO="${1#--repo=}"; shift ;;
    --apply) APPLY=1; shift ;;
    --include-ignored) INCL=1; shift ;;
    --json) JSON=1; shift ;;
    -h|--help) echo "$USAGE"; exit 0 ;;
    *) usage ;;
  esac
done

command -v git >/dev/null 2>&1 || { echo "wt-reap: git not found" >&2; exit 2; }
command -v timeout >/dev/null 2>&1 || { echo "wt-reap: timeout not found" >&2; exit 2; }
[ -n "$REPO" ] || REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || true
[ -n "$REPO" ] && git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || { echo "wt-reap: not a git repository" >&2; exit 2; }

TESTMODE=0; [ "${WT_REAP_TEST:-}" = 1 ] && TESTMODE=1
PIN_PATH=/usr/local/bin:/usr/bin:/bin
GH_SEARCH="$PIN_PATH"
[ "$TESTMODE" -eq 1 ] && [ -n "${WT_REAP_GH_PATH:-}" ] && GH_SEARCH="$WT_REAP_GH_PATH"
PIN=(/usr/bin/env -i "PATH=$PIN_PATH" LANG=C "HOME=${HOME:-}")
for _v in XDG_CONFIG_HOME GH_CONFIG_DIR GH_TOKEN GITHUB_TOKEN GH_HOST GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN; do
  [ -n "${!_v:-}" ] && PIN+=("$_v=${!_v}")
done
unset _v
GH_BIN="$(PATH="$GH_SEARCH" command -v gh 2>/dev/null)"; [[ "$GH_BIN" == /* ]] || GH_BIN=""
PHASE2=0; STOPPED=""   # in the re-check a gh or git-list failure stops the run instead of exiting
gh_unavailable() { echo "wt-reap: gh unavailable" >&2; exit 10; }
[ -n "$GH_BIN" ] || gh_unavailable

TMPD="$(mktemp -d)" || { echo "wt-reap: cannot make a temporary directory" >&2; exit 2; }
trap 'rm -r -- "$TMPD"' EXIT
IGNFILE="$TMPD/exclude-worktree-meta"; printf '%s\n' "/.worktree-meta" >"$IGNFILE"
OWNER_FILE="${XDG_CONFIG_HOME:-${HOME:-}/.config}/wt-reap/ignorable"

# ---- the worktree list, exactly as git gives it (NUL separated) --------------------------------
WP=(); WB=(); WL=()
load_list() {
  WP=(); WB=(); WL=()
  local rec i=-1
  git -C "$REPO" worktree list --porcelain -z >"$TMPD/list" 2>"$TMPD/err" \
    || { echo "wt-reap: git worktree list failed: $(head -c 300 "$TMPD/err")" >&2; [ "$PHASE2" -eq 1 ] && return 1; exit 2; }
  while IFS= read -r -d '' rec; do
    case "$rec" in
      "worktree "*) i=$((i + 1)); WP[i]="${rec#worktree }"; WB[i]=""; WL[i]=0 ;;
      "branch refs/heads/"*) WB[i]="${rec#branch refs/heads/}" ;;
      locked*) WL[i]=1 ;;
    esac
  done <"$TMPD/list"
  return 0
}
load_list
[ "${#WP[@]}" -gt 0 ] || { echo "wt-reap: git listed no worktrees" >&2; exit 2; }
MAIN="${WP[0]}"

default_branch() {
  local h
  h="$(git -C "$MAIN" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)" && [ -n "$h" ] && { echo "${h#origin/}"; return; }
  for h in main master trunk; do
    if git -C "$MAIN" show-ref --verify -q "refs/heads/$h" || git -C "$MAIN" show-ref --verify -q "refs/remotes/origin/$h"; then echo "$h"; return; fi
  done
  echo main
}
DEFBR="$(default_branch)"

# merged_prs BRANCH: the merged pull requests with that head, as "number sha" lines in $TMPD/prs.
# Returns 1 when gh failed or did not answer with a JSON array.
merged_prs() {
  local out obj n s
  out="$(cd "$MAIN" && timeout -k 5 30 "${PIN[@]}" "$GH_BIN" pr list --head "$1" --state merged --limit 100 --json number,headRefOid 2>/dev/null)" || return 1
  [[ "$out" == *\[* ]] || return 1
  : >"$TMPD/prs"
  while [[ "$out" =~ \{[^{}]*\} ]]; do
    obj="${BASH_REMATCH[0]}"; out="${out#*"$obj"}"
    n=""; s=""
    [[ "$obj" =~ \"number\"[[:space:]]*:[[:space:]]*([0-9]+) ]] && n="${BASH_REMATCH[1]}"
    [[ "$obj" =~ \"headRefOid\"[[:space:]]*:[[:space:]]*\"([0-9a-fA-F]+)\" ]] && s="${BASH_REMATCH[1]}"
    printf '%s %s\n' "$n" "$s" >>"$TMPD/prs"
  done
  return 0
}

# is_safe_ignored NAME: 0 when the last path component is regenerable (built-in list or the owner file's globs).
# The owner file is data: each line is only ever used as the pattern of a [[ == ]] test, never evaluated.
is_safe_ignored() {
  local base="$1" g
  case "$base" in
    node_modules|.venv|venv|__pycache__|.pytest_cache|.mypy_cache|.ruff_cache|dist|build|target|.next|.turbo|.cache|coverage|*.pyc|.DS_Store|.worktree-meta) return 0 ;;
  esac
  [ -r "$OWNER_FILE" ] || return 1
  while IFS= read -r g || [ -n "$g" ]; do
    g="${g%$'\r'}"; g="${g#"${g%%[![:space:]]*}"}"; g="${g%"${g##*[![:space:]]}"}"
    case "$g" in ""|"#"*) continue ;; esac
    # shellcheck disable=SC2053
    [[ "$base" == $g ]] && return 0
  done <"$OWNER_FILE"
  return 1
}

# evaluate INDEX: sets V (REMOVABLE|KEEP), REASON, PRN, IGN (ignored entries), OUT (of which outside the safe list),
# META, UPGONE, TIP. When gh fails: exit 10 while judging; in the re-check sets STOPPED and returns.
V=KEEP; REASON=""; PRN=""; IGN=0; OUT=0; META=0; UPGONE=0; TIP=""
keep() { V=KEEP; REASON="$1"; }
evaluate() {
  local i="$1" p b tip up cwdp wtp ents e dirty untracked gd line n s pre ig names nout cfg gp pfx IGNL
  p="${WP[$i]}"; b="${WB[$i]}"; V=KEEP; REASON=""; PRN=""; IGN=0; OUT=0; META=0; UPGONE=0; TIP=""
  # 1
  [ "$i" -eq 0 ] && { keep "main working tree"; return; }
  case "$p" in *-main) keep "path ends in -main"; return ;; esac
  # 2
  wtp="$(cd -P -- "$p" 2>/dev/null && pwd -P)"
  [ -n "$wtp" ] || { keep "git error: worktree directory is missing"; return; }
  cwdp="$(pwd -P)"
  if [ "$cwdp" = "$wtp" ] || [[ "$cwdp" == "$wtp"/* ]]; then keep "current directory is inside it"; return; fi
  # 3
  [ -n "$b" ] || { keep "detached HEAD"; return; }
  [ "$b" = "$DEFBR" ] && { keep "default branch"; return; }
  # 4
  git -C "$p" status --porcelain=v1 -z --untracked-files=normal --ignore-submodules=none --ignored >"$TMPD/status" 2>"$TMPD/err" \
    || { keep "git error: status failed"; return; }
  mapfile -d '' -t ents <"$TMPD/status"
  dirty=0; untracked=0; IGNL=()
  for e in "${ents[@]}"; do
    if [ "$e" = "?? .worktree-meta" ]; then META=1
    elif [[ "$e" == "!! "* ]]; then IGNL+=("${e#!! }")
    elif [[ "$e" == "?? "* ]]; then untracked=1
    else dirty=1; fi
  done
  [ "$dirty" -eq 0 ] || { keep "uncommitted changes"; return; }
  [ "$untracked" -eq 0 ] || { keep "untracked files"; return; }
  IGN="${#IGNL[@]}"
  # ignored entries are deleted with the worktree. A nested repository is never accepted, flag or not.
  for ig in "${IGNL[@]}"; do
    [[ "$ig" == */ ]] || continue
    pfx="${ig%/}"; [ "${pfx##*/}" = node_modules ] && continue
    if [ -n "$(find "$p/$pfx" -maxdepth 6 \( -name node_modules -prune \) -o -name .git -print -quit 2>/dev/null)" ]; then
      keep "nested repository in ignored path"; return
    fi
  done
  nout=0; names=()
  for ig in "${IGNL[@]}"; do
    pfx="${ig%/}"
    is_safe_ignored "${pfx##*/}" || { nout=$((nout + 1)); names+=("$pfx"); }
  done
  OUT="$nout"
  if [ "$nout" -gt 0 ] && [ "$INCL" -eq 0 ]; then
    cfg="$(IFS=,; printf '%s' "${names[*]:0:3}")"; cfg="${cfg//,/, }"
    keep "ignored files outside the safe list ($nout): $cfg"; return
  fi
  # 5
  tip="$(git -C "$p" rev-parse --verify -q "refs/heads/$b^{commit}" 2>/dev/null)" || { keep "git error: cannot read the branch tip"; return; }
  TIP="$tip"; gp=""
  if up="$(git -C "$p" rev-parse --verify -q --end-of-options "$b@{upstream}" 2>/dev/null)"; then
    [ "$tip" = "$up" ] || { keep "unpushed: local tip differs from upstream"; return; }
  else
    # configured but its remote-tracking ref is gone (the usual state after a merge with branch deletion and a
    # pruning fetch): the merged pull request's head must equal the tip instead (condition 6)
    cfg="$(git -C "$p" for-each-ref --format='%(upstream)' "refs/heads/$b" 2>/dev/null)"
    [ -n "$cfg" ] || { keep "no upstream"; return; }
    if git -C "$p" show-ref --verify -q -- "$cfg" 2>/dev/null; then keep "git error: cannot read the upstream"; return; fi
    UPGONE=1; gp="upstream gone: "
  fi
  # 6
  if ! merged_prs "$b"; then
    if [ "$PHASE2" -eq 1 ]; then STOPPED="gh unavailable during the re-check"; return; fi
    gh_unavailable
  fi
  [ -s "$TMPD/prs" ] || { keep "${gp}no merged pull request"; return; }
  while read -r n s; do
    if [ -n "$s" ] && [ "$s" = "$tip" ]; then PRN="$n"; break; fi
  done <"$TMPD/prs"
  [ -n "$PRN" ] || { keep "${gp}merged pull request head differs from branch tip"; return; }
  # 7
  git -C "$MAIN" stash list --format=%gs >"$TMPD/stash" 2>/dev/null || { keep "git error: stash list failed"; return; }
  while IFS= read -r line; do
    case "$line" in "WIP on $b: "*|"On $b: "*) keep "stash entry references the branch"; return ;; esac
  done <"$TMPD/stash"
  [ "${WL[$i]}" -eq 0 ] || { keep "locked"; return; }
  gd="$(git -C "$p" rev-parse --absolute-git-dir 2>/dev/null)" || { keep "git error: cannot find the git directory"; return; }
  for pre in rebase-merge:"rebase in progress" rebase-apply:"rebase in progress" MERGE_HEAD:"merge in progress" \
             CHERRY_PICK_HEAD:"cherry-pick in progress" REVERT_HEAD:"revert in progress" BISECT_LOG:"bisect in progress"; do
    [ -e "$gd/${pre%%:*}" ] && { keep "${pre#*:}"; return; }
  done
  V=REMOVABLE
}

# ---- JSON helpers -------------------------------------------------------------------------------
jstr() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
  s="${s//[[:cntrl:]]/ }"
  printf '"%s"' "$s"
}
# remove_cmd PATH BRANCH: the commands --apply runs (a lone .worktree-meta is handled by one -c option, see notes)
remove_cmd() {
  { printf '%q ' git -C "$MAIN" worktree remove -- "$1"; printf '&& '; printf '%q ' git -C "$MAIN" branch -d -- "$2"; } | sed 's/ $//'
}

# ---- phase 1: judge every linked worktree (nothing is printed until gh has answered for all) -----
N="${#WP[@]}"
RV=(); RR=(); RP=(); RI=(); RO=(); RM=(); RG=(); RT=(); RRES=(); RERR=()
for ((i = 0; i < N; i++)); do
  evaluate "$i"
  RV[i]="$V"; RR[i]="$REASON"; RP[i]="$PRN"; RI[i]="$IGN"; RO[i]="$OUT"; RM[i]="$META"; RG[i]="$UPGONE"; RT[i]="$TIP"; RRES[i]=""; RERR[i]=""
done
# the list as judged; a later load_list (the re-check) can shift indexes after a removal, so results are kept by this copy
OP=("${WP[@]}"); OB=("${WB[@]}")
label() { if [ -n "${OB[$1]}" ]; then printf '%s' "${OB[$1]}"; else printf '(detached)'; fi; }
nrem=0; nkeep=0; nok=0; nfail=0; nskip=0; FINAL_RC=0
for ((i = 0; i < N; i++)); do if [ "${RV[i]}" = REMOVABLE ]; then nrem=$((nrem + 1)); else nkeep=$((nkeep + 1)); fi; done
counts() { printf '(ignored entries: %s, of which outside the safe list: %s)' "${RI[$1]}" "${RO[$1]}"; }

# text mode prints the verdicts now, so that --apply shows each step as it happens
verdict_lines() {
  local line
  for ((i = 0; i < N; i++)); do
    if [ "${RV[i]}" = REMOVABLE ]; then
      line="REMOVABLE ${OP[i]} $(label "$i") pr=${RP[i]}"
      [ "${RG[i]}" -eq 1 ] && line="$line upstream=gone"
      [ "${RI[i]}" -gt 0 ] && line="$line ignored=${RI[i]}"
      printf '%s\n' "$line"
    else
      printf 'KEEP %s %s %s\n' "${OP[i]}" "$(label "$i")" "${RR[i]}"
    fi
  done
}
[ "$JSON" -eq 1 ] || verdict_lines

emit() { [ "$JSON" -eq 1 ] || printf '%s\n' "$1"; }

# ---- phase 2 (apply only): re-check each, then remove ---------------------------------------------
if [ "$APPLY" -eq 1 ]; then
  PHASE2=1
  for ((i = 0; i < N; i++)); do
    [ "${RV[i]}" = REMOVABLE ] || continue
    p="${OP[i]}"; b="${OB[i]}"
    if [ -n "$STOPPED" ]; then RRES[i]=skipped; RERR[i]="$STOPPED"; nskip=$((nskip + 1)); emit "SKIPPED $p $b: $STOPPED"; continue; fi
    # re-read the list and re-judge from scratch immediately before acting
    if ! load_list; then STOPPED="git worktree list failed during the re-check"; fi
    if [ -z "$STOPPED" ]; then
      idx=-1
      for ((k = 0; k < ${#WP[@]}; k++)); do [ "${WP[k]}" = "$p" ] && [ "${WB[k]}" = "$b" ] && idx="$k"; done
      if [ "$idx" -lt 0 ]; then RRES[i]=skipped; RERR[i]="no longer listed with that branch"; nskip=$((nskip + 1)); emit "SKIPPED $p $b: ${RERR[i]}"; continue; fi
      evaluate "$idx"
    fi
    if [ -n "$STOPPED" ]; then
      RRES[i]=skipped; RERR[i]="$STOPPED"; nskip=$((nskip + 1)); emit "SKIPPED $p $b: $STOPPED"; FINAL_RC=10; continue
    fi
    if [ "$V" != REMOVABLE ]; then RRES[i]=skipped; RERR[i]="changed since the report: $REASON"; nskip=$((nskip + 1)); emit "SKIPPED $p $b: ${RERR[i]}"; continue; fi
    RI[i]="$IGN"; RO[i]="$OUT"; RM[i]="$META"; RG[i]="$UPGONE"; RT[i]="$TIP"; RP[i]="$PRN"
    emit "removing $p (ignored entries: $IGN, of which outside the safe list: $OUT)"
    rm_ex=(); [ "$META" -eq 1 ] && rm_ex=(-c "core.excludesFile=$IGNFILE")
    if ! git -C "$MAIN" "${rm_ex[@]}" worktree remove -- "$p" >"$TMPD/out" 2>&1; then
      RRES[i]=failed; RERR[i]="git worktree remove failed: $(head -c 400 "$TMPD/out" | tr '\n' ' ')"; nfail=$((nfail + 1)); emit "FAILED $p $b: ${RERR[i]}"; continue
    fi
    if ! git -C "$MAIN" branch -d -- "$b" >"$TMPD/out" 2>&1; then
      if [ "${RG[i]}" -eq 1 ] && grep -q "not fully merged" "$TMPD/out"; then
        RRES[i]=removed; RERR[i]="branch kept: git does not see it as merged"; nok=$((nok + 1))
        emit "worktree removed; branch $b kept (git does not see it as merged; its tip ${RT[i]} is the head of merged pull request #${RP[i]})"; continue
      fi
      RRES[i]=failed; RERR[i]="worktree removed but git branch -d failed: $(head -c 400 "$TMPD/out" | tr '\n' ' ')"; nfail=$((nfail + 1)); emit "FAILED $p $b: ${RERR[i]}"; continue
    fi
    RRES[i]=removed; nok=$((nok + 1)); emit "removed $p $b $(counts "$i")"
  done
  PHASE2=0
fi
[ "$nfail" -eq 0 ] || [ "$FINAL_RC" -ne 0 ] || FINAL_RC=1
[ "$FINAL_RC" -eq 10 ] && [[ "$STOPPED" == gh* ]] && echo "wt-reap: gh unavailable" >&2

# ---- the rest of the output -----------------------------------------------------------------------
if [ "$JSON" -eq 1 ]; then
  printf '['; first=1
  for ((i = 0; i < N; i++)); do
    [ "$first" -eq 1 ] || printf ','; first=0
    printf '\n{"path":%s,"branch":%s,"verdict":"%s"' "$(jstr "${OP[i]}")" "$( [ -n "${OB[i]}" ] && jstr "${OB[i]}" || printf null )" "${RV[i]}"
    printf ',"reason":%s' "$( [ "${RV[i]}" = KEEP ] && jstr "${RR[i]}" || printf null )"
    printf ',"pr":%s,"ignored":%s,"ignored_outside":%s' "$( [ -n "${RP[i]}" ] && printf '%s' "${RP[i]}" || printf null )" "${RI[i]}" "${RO[i]}"
    printf ',"upstream_gone":%s,"worktree_meta":%s' "$( [ "${RG[i]}" -eq 1 ] && printf true || printf false )" "$( [ "${RM[i]}" -eq 1 ] && printf true || printf false )"
    if [ "${RV[i]}" = REMOVABLE ]; then printf ',"command":%s' "$(jstr "$(remove_cmd "${OP[i]}" "${OB[i]}")")"; else printf ',"command":null'; fi
    if [ "$APPLY" -eq 1 ]; then
      printf ',"result":%s,"error":%s' "$( [ -n "${RRES[i]}" ] && jstr "${RRES[i]}" || printf null )" "$( [ -n "${RERR[i]}" ] && jstr "${RERR[i]}" || printf null )"
    fi
    printf '}'
  done
  printf '\n]\n'
else
  if [ "$APPLY" -eq 0 ]; then
    for ((i = 0; i < N; i++)); do
      [ "${RV[i]}" = REMOVABLE ] || continue
      printf 'would run: %s\n' "$(remove_cmd "${OP[i]}" "${OB[i]}")"
      [ "${RM[i]}" -eq 1 ] && printf 'note: %s: .worktree-meta is treated as ignored for this removal\n' "${OP[i]}"
      [ "${RG[i]}" -eq 1 ] && printf 'note: %s: upstream gone; git branch -d may refuse, and the branch is then kept\n' "${OP[i]}"
    done
    printf 'wt-reap: %d removable, %d keep (report only; nothing changed)\n' "$nrem" "$nkeep"
  else
    printf 'wt-reap: removed %d, failed %d, skipped %d, kept %d\n' "$nok" "$nfail" "$nskip" "$nkeep"
  fi
fi
exit "$FINAL_RC"
