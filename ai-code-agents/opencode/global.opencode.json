{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "sonnet": {
          "id": "anthropic/claude-sonnet-4-5"
        },
        "gpt-4o": {
          "id": "openai/gpt-4o"
        },
        "gemini-flash": {
          "id": "google/gemini-2.0-flash-001"
        },
        "qwen3-coder": {
          "id": "qwen/qwen3-coder:free"
        },
        "minimax-m2": {
          "id": "minimax/minimax-m2.5:free"
        },
        "qwen3-next": {
          "id": "qwen/qwen3-next-80b-a3b-instruct:free"
        }
      }
    }
  },
  "model": "opencode/minimax-m2.5-free",
  "agent": {
    "typecheck":            { "model": "opencode/minimax-m2.5-free" },
    "test-runner":          { "model": "opencode/minimax-m2.5-free" },
    "codebase-locator":     { "model": "opencode/minimax-m2.7" },
    "codebase-analyzer":    { "model": "opencode/kimi-k2.6" },
    "context-synthesis":    { "model": "opencode/qwen3.5-plus" },
    "antipattern-sniffer":  { "model": "opencode/minimax-m2.7" },
    "frontend-developer":   { "model": "opencode/kimi-k2.6" },
    "mobile-developer":     { "model": "opencode/kimi-k2.6" },
    "backend-architect":    { "model": "opencode/glm-5.1" },
    "cloud-architect":      { "model": "opencode/glm-5.1" },
    "database-optimizer":   { "model": "opencode/glm-5.1" },
    "deployment-engineer":  { "model": "opencode/deepseek-v4-pro" },
    "devops-troubleshooter":{ "model": "opencode/deepseek-v4-pro" },
    "performance-engineer": { "model": "opencode/glm-5.1" },
    "test-automator":       { "model": "opencode/minimax-m2.7" }
  },
  "plugin": ["@plannotator/opencode@latest"]
}
