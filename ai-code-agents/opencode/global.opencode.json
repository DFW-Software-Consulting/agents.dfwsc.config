{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenAI",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    },
    "opencode-go": {
      "npm": "@ai-sdk/anthropic",
      "name": "OpenCode Go",
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}",
        "baseURL": "https://opencode.ai/zen/go/v1/messages"
      }
    }
  },
  "model": "opencode/deepseek-v4-flash-free",
  "agent": {
    "working": {
      "permission": {
        "bash": {
          "*": "deny",
          "node ~/.config/opencode/tools/db-readonly.mjs*": "allow",
          "node $HOME/.config/opencode/tools/db-readonly.mjs*": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "read": "allow",
        "edit": "deny",
        "todowrite": "deny",
        "task": "deny"
      }
    },
    "orchestrator": {
      "model": "{env:OPENCODE_ORCHESTRATOR_MODEL}",
      "variant": "{env:OPENCODE_ORCHESTRATOR_VARIANT}"
    },
    "git-runner": {
      "mode": "subagent",
      "model": "{env:OPENCODE_LOCATOR_MODEL}",
      "variant": "{env:OPENCODE_LOCATOR_VARIANT}"
    },
    "check": {
      "mode": "subagent",
      "model": "{env:OPENCODE_FAST_MODEL}",
      "variant": "{env:OPENCODE_FAST_VARIANT}"
    },
    "codebase-locator": {
      "model": "{env:OPENCODE_LOCATOR_MODEL}",
      "variant": "{env:OPENCODE_LOCATOR_VARIANT}"
    },
    "codebase-analyzer": {
      "model": "{env:OPENCODE_ANALYZER_MODEL}",
      "variant": "{env:OPENCODE_ANALYZER_VARIANT}"
    },
    "context-synthesis": {
      "model": "{env:OPENCODE_CONTEXT_MODEL}",
      "variant": "{env:OPENCODE_CONTEXT_VARIANT}"
    },
    "antipattern-sniffer": {
      "model": "{env:OPENCODE_SNIFFER_MODEL}",
      "variant": "{env:OPENCODE_SNIFFER_VARIANT}"
    },
    "frontend-developer": {
      "model": "{env:OPENCODE_FRONTEND_MODEL}",
      "variant": "{env:OPENCODE_FRONTEND_VARIANT}"
    },
    "mobile-developer": {
      "model": "{env:OPENCODE_MOBILE_MODEL}",
      "variant": "{env:OPENCODE_MOBILE_VARIANT}"
    },
    "backend-architect": {
      "model": "{env:OPENCODE_BACKEND_MODEL}",
      "variant": "{env:OPENCODE_BACKEND_VARIANT}"
    },
    "cloud-architect": {
      "model": "{env:OPENCODE_CLOUD_MODEL}",
      "variant": "{env:OPENCODE_CLOUD_VARIANT}"
    },
    "database-optimizer": {
      "model": "{env:OPENCODE_DB_MODEL}",
      "variant": "{env:OPENCODE_DB_VARIANT}"
    },
    "deployment-engineer": {
      "model": "{env:OPENCODE_DEPLOY_MODEL}",
      "variant": "{env:OPENCODE_DEPLOY_VARIANT}"
    },
    "devops-troubleshooter": {
      "model": "{env:OPENCODE_DEVOPS_MODEL}",
      "variant": "{env:OPENCODE_DEVOPS_VARIANT}"
    },
    "performance-engineer": {
      "model": "{env:OPENCODE_PERF_MODEL}",
      "variant": "{env:OPENCODE_PERF_VARIANT}"
    },
    "test-automator": {
      "model": "{env:OPENCODE_TEST_AUTOMATOR_MODEL}",
      "variant": "{env:OPENCODE_TEST_AUTOMATOR_VARIANT}"
    },
    "executor": {
      "model": "{env:OPENCODE_EXECUTOR_MODEL}",
      "variant": "{env:OPENCODE_EXECUTOR_VARIANT}"
    },
    "general": {
      "model": "{env:OPENCODE_GENERAL_MODEL}",
      "variant": "{env:OPENCODE_GENERAL_VARIANT}"
    },
    "explore": {
      "model": "{env:OPENCODE_EXPLORE_MODEL}",
      "variant": "{env:OPENCODE_EXPLORE_VARIANT}"
    },
    "response-reviewer": {
      "model": "{env:OPENCODE_RESPONSE_REVIEWER_MODEL}",
      "variant": "{env:OPENCODE_RESPONSE_REVIEWER_VARIANT}"
    },
    "spec-reviewer": {
      "model": "{env:OPENCODE_SPEC_REVIEWER_MODEL}",
      "variant": "{env:OPENCODE_SPEC_REVIEWER_VARIANT}"
    }
  },
  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "manual"
      }
    ]
  ],
  "mcp": {
    "github": {
      "type": "local",
      "enabled": false,
      "command": [
        "sh",
        "/home/messyginger0804/.config/opencode/github-mcp.sh"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}",
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}",
        "GH_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "dfwsc": {
      "type": "local",
      "enabled": false,
      "command": [
        "node",
        "/home/messyginger0804/dfwsc/dfwsc-mcp/src/index.js"
      ],
      "environment": {
        "COOLIFY_URL": "{env:COOLIFY_URL}",
        "COOLIFY_TOKEN": "{env:COOLIFY_TOKEN}",
        "NEXTCLOUD_URL": "{env:NEXTCLOUD_URL}",
        "NEXTCLOUD_USER": "{env:NEXTCLOUD_USER}",
        "NEXTCLOUD_PASSWORD": "{env:NEXTCLOUD_PASSWORD}",
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}",
        "GITHUB_OWNER": "{env:GITHUB_OWNER}",
        "GITHUB_REPO": "{env:GITHUB_REPO}"
      }
    },
    "nextcloud": {
      "type": "local",
      "enabled": false,
      "command": [
        "uvx",
        "nextcloud-mcp-server",
        "run",
        "--transport",
        "stdio"
      ],
      "environment": {
        "NEXTCLOUD_HOST": "{env:NEXTCLOUD_URL}",
        "NEXTCLOUD_USERNAME": "{env:NEXTCLOUD_USER}",
        "NEXTCLOUD_PASSWORD": "{env:NEXTCLOUD_PASSWORD}"
      }
    },
    "stripe": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@stripe/mcp"
      ],
      "enabled": true,
      "environment": {
        "STRIPE_SECRET_KEY": "{env:STRIPE_SECRET_KEY}"
      }
    },
    "coolify": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@masonator/coolify-mcp@latest"
      ],
      "environment": {
        "COOLIFY_BASE_URL": "{env:COOLIFY_URL}",
        "COOLIFY_ACCESS_TOKEN": "{env:COOLIFY_TOKEN}"
      }
    }
  }
}
