{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenAI",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    },
    "opencode-go": {
      "npm": "@ai-sdk/anthropic",
      "name": "OpenCode Go",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1"
      }
    }
  },
  "default_agent": "{env:OPENCODE_DEFAULT_AGENT}",
  "model": "{env:OPENCODE_PRIMARY_MODEL}",
  "small_model": "{env:OPENCODE_SMALL_MODEL}",
  "agent": {
    "build": {
      "model": "{env:OPENCODE_PRIMARY_MODEL}",
      "variant": "{env:OPENCODE_PRIMARY_VARIANT}"
    },
    "plan": {
      "model": "{env:OPENCODE_PLAN_MODEL}",
      "variant": "{env:OPENCODE_PLAN_VARIANT}"
    },
    "working": {
      "permission": {
        "bash": {
          "*": "deny",
          "node ~/.config/opencode/tools/db-readonly.mjs*": "allow",
          "node $HOME/.config/opencode/tools/db-readonly.mjs*": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "read": "allow",
        "edit": "deny",
        "todowrite": "deny",
        "task": "deny"
      }
    },
    "git-runner": {
      "mode": "subagent",
      "model": "{env:OPENCODE_LOCATOR_MODEL}",
      "variant": ""
    },
    "sql-runner": {
      "mode": "subagent",
      "model": "{env:OPENCODE_LOCATOR_MODEL}",
      "variant": ""
    },
    "check": {
      "mode": "subagent",
      "model": "{env:OPENCODE_FAST_MODEL}",
      "variant": "{env:OPENCODE_FAST_VARIANT}"
    },
    "codebase-locator": {
      "model": "{env:OPENCODE_LOCATOR_MODEL}",
      "variant": "{env:OPENCODE_LOCATOR_VARIANT}"
    },
    "codebase-analyzer": {
      "model": "{env:OPENCODE_ANALYZER_MODEL}",
      "variant": "{env:OPENCODE_ANALYZER_VARIANT}"
    },
    "context-synthesis": {
      "model": "{env:OPENCODE_CONTEXT_MODEL}",
      "variant": "{env:OPENCODE_CONTEXT_VARIANT}"
    },
    "antipattern-sniffer": {
      "model": "{env:OPENCODE_SNIFFER_MODEL}",
      "variant": "{env:OPENCODE_SNIFFER_VARIANT}"
    },
    "frontend-developer": {
      "model": "{env:OPENCODE_FRONTEND_MODEL}",
      "variant": "{env:OPENCODE_FRONTEND_VARIANT}"
    },
    "mobile-developer": {
      "model": "{env:OPENCODE_MOBILE_MODEL}",
      "variant": "{env:OPENCODE_MOBILE_VARIANT}"
    },
    "backend-architect": {
      "model": "{env:OPENCODE_BACKEND_MODEL}",
      "variant": "{env:OPENCODE_BACKEND_VARIANT}"
    },
    "backend-fix-workunit": {
      "model": "{env:OPENCODE_BACKEND_MODEL}",
      "variant": "{env:OPENCODE_BACKEND_VARIANT}"
    },
    "frontend-fix-workunit": {
      "model": "{env:OPENCODE_FRONTEND_MODEL}",
      "variant": "{env:OPENCODE_FRONTEND_VARIANT}"
    },
    "cloud-architect": {
      "model": "{env:OPENCODE_CLOUD_MODEL}",
      "variant": "{env:OPENCODE_CLOUD_VARIANT}"
    },
    "database-optimizer": {
      "model": "{env:OPENCODE_DB_MODEL}",
      "variant": "{env:OPENCODE_DB_VARIANT}"
    },
    "deployment-engineer": {
      "model": "{env:OPENCODE_DEPLOY_MODEL}",
      "variant": "{env:OPENCODE_DEPLOY_VARIANT}"
    },
    "devops-troubleshooter": {
      "model": "{env:OPENCODE_DEVOPS_MODEL}",
      "variant": "{env:OPENCODE_DEVOPS_VARIANT}"
    },
    "performance-engineer": {
      "model": "{env:OPENCODE_PERF_MODEL}",
      "variant": "{env:OPENCODE_PERF_VARIANT}"
    },
    "test-automator": {
      "model": "{env:OPENCODE_TEST_AUTOMATOR_MODEL}",
      "variant": "{env:OPENCODE_TEST_AUTOMATOR_VARIANT}"
    },
    "executor": {
      "model": "{env:OPENCODE_EXECUTOR_MODEL}",
      "variant": "{env:OPENCODE_EXECUTOR_VARIANT}"
    },
    "general": {
      "mode": "subagent",
      "model": "{env:OPENCODE_GENERAL_MODEL}",
      "variant": "{env:OPENCODE_GENERAL_VARIANT}"
    },
    "explore": {
      "mode": "subagent",
      "model": "{env:OPENCODE_EXPLORE_MODEL}",
      "variant": "{env:OPENCODE_EXPLORE_VARIANT}"
    },
    "spec-reviewer": {
      "model": "{env:OPENCODE_SPEC_REVIEWER_MODEL}",
      "variant": "{env:OPENCODE_SPEC_REVIEWER_VARIANT}"
    }
  },
  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "manual"
      }
    ],
    "file:///home/messyginger0804/dfwsc/agents.dfwsc.config/ai-code-agents/opencode/free-mode.ts",
    "file:///home/messyginger0804/dfwsc/agents.dfwsc.config/ai-code-agents/opencode/plugins/mixed-model-guard"
  ],
  "mcp": {
    "read-ai": {
      "type": "remote",
      "url": "https://api.read.ai/mcp",
      "enabled": true
    },
    "calcom": {
      "type": "remote",
      "url": "https://mcp.cal.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "local",
      "enabled": true,
      "command": [
        "sh",
        "/home/messyginger0804/.config/opencode/github-mcp.sh"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}",
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}",
        "GH_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "nextcloud": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--with",
        "importlib-metadata",
        "nextcloud-mcp-server",
        "run",
        "--transport",
        "stdio"
      ],
      "environment": {
        "NEXTCLOUD_HOST": "{env:NEXTCLOUD_URL}",
        "NEXTCLOUD_USERNAME": "{env:NEXTCLOUD_USER}",
        "NEXTCLOUD_PASSWORD": "{env:NEXTCLOUD_PASSWORD}"
      }
    },
    "stripe": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        ". \"$HOME/.secrets\"; exec npx -y @stripe/mcp"
      ],
      "enabled": true
    },
    "coolify": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@masonator/coolify-mcp@latest"
      ],
      "environment": {
        "COOLIFY_BASE_URL": "{env:COOLIFY_URL}",
        "COOLIFY_ACCESS_TOKEN": "{env:COOLIFY_TOKEN}"
      }
    },
    "supabase": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--read-only",
        "--project-ref=ojdjvnvtuhzolcpqdmju"
      ],
      "environment": {
        "SUPABASE_ACCESS_TOKEN": "{env:SUPABASE_ACCESS_TOKEN}"
      }
    },
    "slack": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "client_id": "{file:~/.config/opencode/secrets/slack-client-id}",
        "client_secret": "{file:~/.config/opencode/secrets/slack-client-secret}",
        "scope": "canvases:read canvases:write channels:history channels:read channels:write chat:write emoji:read files:read files:write groups:history groups:read groups:write im:history im:read im:write lists:read lists:write mpim:history mpim:read mpim:write reactions:read reactions:write search:read.files search:read.im search:read.mpim search:read.private search:read.public search:read.users users:read users:read.email",
        "callback_port": 19876,
        "redirect_uri": "http://127.0.0.1:19876/callback"
      }
    },
    "supabase-oauth": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.supabase.com/mcp?project_ref=ojdjvnvtuhzolcpqdmju&read_only=true",
      "oauth": {}
    },
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--user-data-dir",
        "/home/messyginger0804/.config/opencode/browser-profile",
        "--output-dir",
        "/home/messyginger0804/.config/opencode/browser-output"
      ]
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "brain": {
      "type": "remote",
      "url": "https://brain.craftdigital.dev/api/mcp",
      "enabled": true,
      "oauth": {},
      "timeout": 90000
    },
    "brain-local": {
      "type": "local",
      "enabled": true,
      "command": [
        "bun",
        "run",
        "/home/messyginger0804/.config/opencode/tools/brain-mcp.ts"
      ]
    }
  }
}
