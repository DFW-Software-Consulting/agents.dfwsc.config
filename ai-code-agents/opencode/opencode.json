{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "openai": {
            "npm": "@ai-sdk/openai",
            "name": "OpenAI",
            "options": {
                "apiKey": "{env:OPENAI_API_KEY}"
            },
            "models": {
                "chatgpt-5.4": {
                    "name": "ChatGPT 5.4",
                    "limit": {
                        "context": 128000,
                        "output": 16384
                    }
                }
            }
        },
        "vllm": {
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "http://localhost:8000/v1"
            },
            "models": {
                "qwen-coder": {
                    "id": "Qwen/Qwen2.5-Coder-3B-Instruct",
                    "maxTokens": 24576
                }
            }
        }
    },
    "model": "{env:OPENCODE_FAST_MODEL}",
    "experimental": {
        "hook": {
            "file_edited": {
                ".json": [
                    {
                        "command": ["bun", "run", "prettier", "$FILE"]
                    }
                ]
            },
            "session_completed": [
                {
                    "command": ["touch", "./node_modules/foo"]
                }
            ]
        }
    },
    "agent": {
        "review": {
            "description": "Reviews code for best practices and potential issues"
        },
        "git-runner": { "mode": "subagent", "model": "{env:OPENCODE_FAST_MODEL}" },
        "typecheck": { "model": "{env:OPENCODE_FAST_MODEL}" },
        "test-runner": { "model": "{env:OPENCODE_FAST_MODEL}" },
        "lint": { "mode": "subagent", "model": "{env:OPENCODE_FAST_MODEL}" },
        "prettier": { "mode": "subagent", "model": "{env:OPENCODE_FAST_MODEL}" },
        "codebase-locator": { "model": "{env:OPENCODE_LOCATOR_MODEL}" },
        "codebase-analyzer": { "model": "{env:OPENCODE_ANALYZER_MODEL}" },
        "context-synthesis": { "model": "{env:OPENCODE_CONTEXT_MODEL}" },
        "antipattern-sniffer": { "model": "{env:OPENCODE_SNIFFER_MODEL}" },
        "frontend-developer": { "model": "{env:OPENCODE_FRONTEND_MODEL}" },
        "mobile-developer": { "model": "{env:OPENCODE_MOBILE_MODEL}" },
        "backend-architect": { "model": "{env:OPENCODE_BACKEND_MODEL}" },
        "cloud-architect": { "model": "{env:OPENCODE_CLOUD_MODEL}" },
        "database-optimizer": { "model": "{env:OPENCODE_DB_MODEL}" },
        "deployment-engineer": { "model": "{env:OPENCODE_DEPLOY_MODEL}" },
        "devops-troubleshooter": { "model": "{env:OPENCODE_DEVOPS_MODEL}" },
        "performance-engineer": { "model": "{env:OPENCODE_PERF_MODEL}" },
        "test-automator": { "model": "{env:OPENCODE_TEST_MODEL}" }
    },
    "mcp": {
      "shopify": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "shopify-mcp-server"
        ],
        "enabled": true
      }
    },
    "plugin": [["@plannotator/opencode@latest", { "workflow": "manual" }]]
}
